generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──── Auth (NextAuth adapter tables) ─────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  role          UserRole      @default(VIEWER)
  accounts      Account[]
  sessions      Session[]
  activities    ActivityLog[]
  worklogs      WorkLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ──── Core Business ───────────────────────────────────────────────────────

model BusinessEntity {
  id        String    @id @default(cuid())
  name      String
  type      String
  taxId     String?
  address   String?
  email     String?
  notes     String?   @db.Text
  isActive  Boolean   @default(true)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Client {
  id               String       @id @default(cuid())
  name             String
  type             String?
  industry         String?
  website          String?
  businessEntityId String?
  status           ClientStatus @default(LEAD)
  source           String?
  notes            String?      @db.Text
  contacts         Contact[]
  projects         Project[]
  clientNotes      Note[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Contact {
  id              String    @id @default(cuid())
  fullName        String
  role            String?
  email           String?
  phone           String?
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  isPrimary       Boolean   @default(false)
  notes           String?   @db.Text
  primaryProjects Project[] @relation("PrimaryContact")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ProjectStatus {
  id       String     @id @default(cuid())
  code     StatusCode @unique
  label    String
  color    String
  order    Int
  projects Project[]
}

model Project {
  id                 String           @id @default(cuid())
  name               String
  clientId           String
  client             Client           @relation(fields: [clientId], references: [id])
  businessEntityId   String
  businessEntity     BusinessEntity   @relation(fields: [businessEntityId], references: [id])
  primaryContactId   String?
  primaryContact     Contact?         @relation("PrimaryContact", fields: [primaryContactId], references: [id])
  description        String?          @db.Text
  type               String?
  statusId           String
  status             ProjectStatus    @relation(fields: [statusId], references: [id])
  platform           String?
  startDate          DateTime?
  targetDate         DateTime?
  nextMilestoneDate  DateTime?
  priority           Priority         @default(MEDIUM)
  internalNotes      String?          @db.Text
  contractOneTime       Decimal?         @db.Decimal(12, 2)
  contractRecurring     Decimal?         @db.Decimal(12, 2)
  contractRecurringType String?
  totalContractValue    Decimal?         @db.Decimal(12, 2)
  currency              String           @default("ILS")
  milestones         Milestone[]
  payments           Payment[]
  costs              Cost[]
  partners           ProjectPartner[]
  documents          Document[]
  technicalLink      TechnicalLink?
  worklogs           WorkLog[]
  tasks              Task[]
  projectNotes       Note[]
  activities         ActivityLog[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Milestone {
  id              String              @id @default(cuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  description     String?             @db.Text
  amount          Decimal?            @db.Decimal(12, 2)
  percentage      Decimal?            @db.Decimal(5, 2)
  targetDate      DateTime?
  executionStatus MilestoneExecStatus @default(PENDING)
  completedAt     DateTime?
  paymentStatus   PaymentStatus       @default(PENDING)
  paidAmount      Decimal?            @db.Decimal(12, 2)
  paidAt          DateTime?
  notes           String?             @db.Text
  payments        Payment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId   String?
  milestone     Milestone?    @relation(fields: [milestoneId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("ILS")
  requestDate   DateTime?
  paidDate      DateTime?
  status        PaymentStatus @default(PENDING)
  method        String?
  invoiceNumber String?
  invoiceLink   String?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Cost {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costType      CostType
  billingType   BillingType @default(ONE_TIME)
  description   String?
  vendor        String?
  amount        Decimal     @db.Decimal(12, 2)
  currency      String      @default("ILS")
  date          DateTime?
  isPaid        Boolean     @default(false)
  paymentMethod String?
  invoiceLink   String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Partner {
  id        String           @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?          @db.Text
  projects  ProjectPartner[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ProjectPartner {
  id                 String        @id @default(cuid())
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partnerId          String
  partner            Partner       @relation(fields: [partnerId], references: [id])
  role               String?
  agreementType      AgreementType @default(PERCENTAGE)
  contractPercentage Decimal?      @db.Decimal(5, 2)
  profitPercentage   Decimal?      @db.Decimal(5, 2)
  fixedAmount        Decimal?      @db.Decimal(12, 2)
  notes              String?       @db.Text
  agreementLink      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([projectId, partnerId])
}

model Document {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  type           DocumentType
  link           String?
  fileAttachment String?
  version        String?
  uploadedBy     String?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model TechnicalLink {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform         String?
  systemUrl        String?
  hostingUrl       String?
  hostingProvider  String?
  dbUrl            String?
  dbProvider       String?
  gitUrl           String?
  repoName         String?
  productionUrl    String?
  devUrl           String?
  integrationNotes String?  @db.Text
  technicalNotes   String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WorkLog {
  id                    String         @id @default(cuid())
  projectId             String
  project               Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workDate              DateTime
  startTime             String?
  endTime               String?
  totalHours            Decimal        @db.Decimal(5, 2)
  performedBy           String
  performerType         PerformerType  @default(INTERNAL)
  workType              WorkType
  workDescription       String?        @db.Text
  billable              Boolean        @default(true)
  hourlyRate            Decimal?       @db.Decimal(10, 2)
  calculatedCost        Decimal?       @db.Decimal(12, 2)
  supplierId            String?
  supplierPaymentStatus PaymentStatus?
  invoiceLink           String?
  notes                 String?        @db.Text
  userId                String?
  user                  User?          @relation(fields: [userId], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Note {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  noteType   String?
  content    String     @db.Text
  createdBy  String
  projectId  String?
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model ActivityLog {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  createdBy  String
  user       User       @relation(fields: [createdBy], references: [id])
  projectId  String?
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
}

model Task {
  id         String     @id @default(cuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  assignee   String?
  targetDate DateTime?
  status     TaskStatus @default(TODO)
  notes      String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ──── Enums ───────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  PARTNER
  VIEWER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  LEAD
  CHURNED
}

enum StatusCode {
  SPEC_BEFORE_QUOTE
  QUOTE_BEFORE_SPEC
  QUOTE_SENT
  NEGOTIATION
  DEVELOPMENT
  DELIVERED_V1
  BUG_FIXES
  SUPPORT
  QUOTE_REJECTED
  ON_HOLD
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneExecStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum PaymentStatus {
  PENDING
  REQUESTED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum CostType {
  DEVELOPMENT
  DESIGN
  HOSTING
  TOOLS
  LICENSES
  PARTNER
  SUBCONTRACTOR
  OTHER
}

enum BillingType {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum AgreementType {
  PERCENTAGE
  PROFIT_SHARE
  FIXED
}

enum DocumentType {
  SPEC
  QUOTE
  CONTRACT
  INVOICE
  DESIGN
  OTHER
}

enum PerformerType {
  INTERNAL
  PARTNER
  EXTERNAL
}

enum WorkType {
  SPEC
  QUOTE
  DEVELOPMENT
  DESIGN
  QA
  BUG_FIXES
  CLIENT_MEETING
  PROJECT_MANAGEMENT
  SUPPORT
  INTEGRATIONS
  RESEARCH
  CONTENT
  TRAINING
  DEVOPS
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum EntityType {
  PROJECT
  CLIENT
  PARTNER
  BUSINESS_ENTITY
}
